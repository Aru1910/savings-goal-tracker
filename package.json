{
  "name": "savings-goal-tracker",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Savings goal tracker with analytics dashboard. Express serves static assets, all data lives in localStorage.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./src/styles/input.css -o ./public/css/styles.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i ./src/styles/input.css -o ./public/css/styles.css --watch",
    "start": "node server.js",
    "dev": "concurrently -k -n css,server \"npm:watch:css\" \"node --watch server.js\"",
    "build": "npm run build:css"
  },
  "engines": { "node": ">=18" },
  "dependencies": { "express": "^4.21.2" },
  "devDependencies": { "concurrently": "^9.1.0", "tailwindcss": "^3.4.17" }
}
